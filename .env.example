# ───────────────────────────────────────────────────────────────
# Slopolis environment variables (example — copy to .env, no secrets)
# ───────────────────────────────────────────────────────────────

# Public base URL of the API server
APP_URL=http://localhost:8400

# Database (SQLAlchemy async / asyncpg driver)
DATABASE_URL=postgresql+asyncpg://slopolis:slopolis@localhost:5432/slopolis

# Redis (ARQ broker / cache)
REDIS_URL=redis://localhost:6379/0

# Fernet key for encrypting secrets at rest (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-key

# GitHub App
GITHUB_APP_ID=000000
GITHUB_APP_PRIVATE_KEY=replace-me-with-the-pem-contents
GITHUB_WEBHOOK_SECRET=replace-me-with-a-webhook-secret
# Optional: the App's slug, as in https://github.com/apps/<slug>. Only used to
# build the install URL; when unset it is read from GitHub on first use.
GITHUB_APP_SLUG=slopolis-dev

GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# LiteLLM gateway
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-replace-me
