# Copy this file to ../.env (repo root) and fill in real values.
# Placeholders only — never commit real credentials.

# --- Postgres ---
POSTGRES_USER=slopolis
POSTGRES_PASSWORD=slopolis
POSTGRES_DB=slopolis

# Connection string matching the postgres service above.
DATABASE_URL=postgresql://slopolis:slopolis@localhost:5432/slopolis

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LiteLLM gateway (only needed with the `litellm` profile) ---
LITELLM_MASTER_KEY=change-me-master-key
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=change-me-provider-key
